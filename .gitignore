# ==============================================================================
# Security & Environment Variables
# ==============================================================================
# Ignore all local environment and secret files
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# Explicitly allow safe example / template configuration files
!.env.example
!.env.template
!.env.sample

# Private keys, certificates, secrets, and auth credentials
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.pkcs12
*.asc
*.pub
*secret*
*credential*
*token*
*.id_rsa
*.id_ed25519
service-account*.json
firebase-adminsdk*.json
google-services.json
GoogleService-Info.plist

